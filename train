        # 双重验证：1. 文件夹是否存在 2. 文件夹是否非空（避免空文件夹占用ID）
        if os.path.exists(patient_folder_path):
            # 可选：进一步验证文件夹内是否有核心数据文件（提升有效性，可根据需求调整）
            has_core_files = False
            # 检查是否有OpenFace AU文件和文本文件（核心数据，缺一不可）
            for file_name in os.listdir(patient_folder_path):
                if file_name.endswith("_OpenFace2.1.0_Pose_gaze_AUs_openface_f16.npy") or \
