                    has_core_files = True
                    break
            # 若文件夹存在且包含核心数据，加入有效ID列表
            if has_core_files:
                patient_ids.append(pid)
            else:
                print(f"️ 患者{pid}文件夹存在，但无核心数据文件，跳过")
        else:
            # 文件夹不存在，直接跳过，不打印冗余日志（如需排查可取消注释）
            # print(f" 患者{pid}文件夹不存在，跳过")
            continue

    # 可选：排序患者ID（确保顺序从300到718，符合预期）
    patient_ids.sort()

    # 打印统计信息，确认有效患者数量
    total_expected = end_pid - start_pid + 1
    total_valid = len(patient_ids)
    print(f" 成功识别 {total_valid} 个有效患者（区间：{start_pid}-{end_pid}，共{total_expected}个ID）")
    print(f"️ 跳过 {total_expected - total_valid} 个无数据/无效ID")

    # 步骤2：准备所有患者的对齐数据
    all_au, all_text, all_labels, scaler = prepare_all_data(patient_ids)

    # 步骤3：训练微表情模型（K-Fold交叉验证）
    fold_results, final_model = train_model(all_au, all_text, all_labels, n_splits=5)

    # 步骤4：保存标准化器
    scaler_save_path = os.path.join(MODEL_DIR, "au_scaler.npy")
    np.save(scaler_save_path, [scaler.mean_, scaler.scale_])
    print(f"\n 标准化器保存完成（路径：{scaler_save_path}）")
